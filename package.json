{
  "name": "auth-forms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:driver": "vite --config vite.driver.config.js",
    "dev:forwarder": "vite --config vite.forwarder.config.js",
    "dev:customer": "vite --config vite.customer.config.js",
    "dev:factor": "vite --config vite.factor.config.js",
    "build:driver": "vite build --config vite.driver.config.js",
    "build:forwarder": "vite build --config vite.forwarder.config.js",
    "build:customer": "vite build --config vite.customer.config.js",
    "build:factor": "vite build --config vite.factor.config.js",
    "deploy:driver": "npm run build:driver && node deploy.js --env=driver",
    "deploy:forwarder": "npm run build:forwarder && node deploy.js --env=forwarder",
    "deploy:customer": "npm run build:customer && node deploy.js --env=customer",
    "deploy:factor": "npm run build:factor && node deploy.js --env=factor"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "axios": "^1.15.2",
    "dotenv": "^17.4.2",
    "ftp-deploy": "^2.4.7",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.77.0",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.9"
  }
}
